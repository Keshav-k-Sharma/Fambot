# Copy to .env and set values. See README Environment variables.

FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=firebase-admin.json
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FAMBOT_JWT_SECRET=generate-with-openssl-rand-hex-32
FAMBOT_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_REPORT_MODEL=gemini-2.5-flash
# GEMINI_CHAT_TITLE_MODEL=gemini-2.5-flash-lite
# Gemini File Search: indexes uploads for future RAG; set to 1 to disable store + ingest.
# Chat turns use function tools, not built-in File Search, because Gemini rejects mixing both.
# FAMBOT_GEMINI_DISABLE_FILE_SEARCH=1

HOST=0.0.0.0
PORT=8000

# Optional: override default repo-root cardiovascular_model.pkl
# MODEL_PATH=/absolute/path/to/cardiovascular_model.pkl

# Family invites: link TTL (seconds) and optional URL prefix for invite_url / QR (default TTL 86400)
# FAMBOT_FAMILY_INVITE_TTL_SECONDS=86400
# FAMBOT_INVITE_BASE_URL=https://your-app.example.com/join

# Optional local-only shortcuts (do not use in production)
# FAMBOT_SKIP_AUTH=1
# FAMBOT_DEV_UID=dev-user
# FAMBOT_SKIP_FIRESTORE=1

# Optional: opt-in pytest external tests (live Identity Toolkit / HTTP)
# FAMBOT_RUN_EXTERNAL_TESTS=1
# FAMBOT_EXTERNAL_TEST_EMAIL=
# FAMBOT_EXTERNAL_TEST_PASSWORD=
# FAMBOT_EXTERNAL_HEALTH_URL=https://example.com/health
